<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geo.dsp.module.user.mapper.UserImageMapper">
    <resultMap id="UserImageResultMap" type="com.geo.dsp.module.user.entity.UserImage">
        <id column="id" property="id"/>
        <result column="image" property="image"/>
        <result column="is_del" property="isDel"/>
    </resultMap>

    <select id="selectById" resultMap="UserImageResultMap">
        SELECT * FROM user_image WHERE id = #{id} AND is_del = false
    </select>

    <insert id="insert">
        INSERT INTO user_image (image, is_del) VALUES (#{image}, #{isDel})
    </insert>

    <update id="deleteById">
        UPDATE user_image SET is_del = true WHERE id = #{id}
    </update>

</mapper>